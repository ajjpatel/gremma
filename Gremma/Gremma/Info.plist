<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>Gremma</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1</string>
<key>CFBundleVersion</key><string>1</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>UILaunchScreen</key><dict/>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
<key>NSCameraUsageDescription</key><string>Gremma records the activities you choose to remember. Processing stays on this iPhone.</string>
<key>NSMicrophoneUsageDescription</key><string>Gremma uses your microphone for spoken requests. Activity videos are recorded without audio.</string>
<key>NSSpeechRecognitionUsageDescription</key><string>Gremma recognizes your English spoken requests on this iPhone.</string>
<key>NSPhotoLibraryUsageDescription</key><string>Choose an activity video to remember on your iPhone.</string>
<key>NSLocalNetworkUsageDescription</key><string>When you enable the video receiver, Gremma accepts activity videos from your Arduino VENTUNO Q on your private Wi-Fi network.</string>
<key>NSBonjourServices</key><array><string>_gremma-video._tcp</string></array>
<key>UIFileSharingEnabled</key><true/>
<key>LSSupportsOpeningDocumentsInPlace</key><true/>
<key>UIApplicationSupportsIndirectInputEvents</key><true/>
</dict></plist>
